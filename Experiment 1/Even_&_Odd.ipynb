      "source": [
        "num = int(input(\"Enter a number: \"))\n",
        "\n",
        "if (num % 2) == 0:\n",
        "   print(f\"{num} is an even number\")\n",
        "else:\n",
        "   print(f\"{num} is an odd number\")"
      ],
